# =============================================================================
# YADAH V2 — Environment template
# =============================================================================
# Copy to `.env` and fill in real values:  cp .env.example .env
#
# `.env` is gitignored and dockerignored. NEVER commit real secrets.
#
# NAMING RULES (React Router v8 / Vite):
#   - Unprefixed vars are SERVER-ONLY. They are read via `process.env` inside
#     loaders/actions and are never shipped to the browser.
#   - `VITE_`-prefixed vars are INLINED INTO THE CLIENT BUNDLE at build time and
#     are publicly readable. Put nothing secret behind a VITE_ prefix.
#   - Anything the browser needs but that varies per environment should instead
#     be passed down from the root loader — see PUBLIC RUNTIME CONFIG below.
# =============================================================================


# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Public origin of THIS frontend. Used for absolute URLs (redirects, PDF links,
# Paystack return URLs). No trailing slash.
APP_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Backend API  (server-only — the browser never talks to the API directly)
# -----------------------------------------------------------------------------
# Base URL including the /api/v1 prefix. No trailing slash.
#   staging: https://staging-backend.yadahdynamic.com/api/v1
API_BASE_URL=https://staging-backend.yadahdynamic.com/api/v1

# Milliseconds before an outbound API request is aborted.
API_TIMEOUT_MS=15000

# How many times to retry idempotent GETs on 502/503/network failure.
# Never retry POSTs here — money endpoints are protected by idempotencyKey
# in the request body instead.
API_RETRY_ATTEMPTS=2

# Log every outbound API call (method, path, status, duration). Dev only —
# leave off in production, request bodies may contain customer PII.
API_DEBUG_LOGGING=true


# -----------------------------------------------------------------------------
# Session cookie  (SECRET — required)
# -----------------------------------------------------------------------------
# Signs the httpOnly session cookie that holds the API access + refresh tokens.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Optional. Set to the OLD secret when rotating SESSION_SECRET so existing
# sessions verify against it while new cookies are signed with the new one.
# Remove after the rotation window (>= SESSION_MAX_AGE_SECONDS) has elapsed.
SESSION_SECRET_PREVIOUS=

SESSION_COOKIE_NAME=__yadah_session

# Absolute lifetime of the session cookie. 30 days.
# The API refresh token governs real session length; this is the outer bound.
SESSION_MAX_AGE_SECONDS=2592000

# MUST be true in production (HTTPS only). false for local http://localhost.
SESSION_COOKIE_SECURE=false

# "lax" is correct here. Do not use "none" — it would allow cross-site sends.
SESSION_COOKIE_SAME_SITE=lax

# Leave blank for host-only cookies (recommended). Set only if the app is
# served from multiple subdomains, e.g. ".yadahdynamic.com".
SESSION_COOKIE_DOMAIN=

# Refresh the access token this many seconds BEFORE it expires (~15 min life),
# so a request never races the expiry boundary.
# NOTE: refresh tokens are SINGLE-USE and rotate on every call. Reusing an old
# one revokes the whole session — the client must serialize refreshes through
# one mutex. See TASK.md §3.2.
AUTH_REFRESH_SKEW_SECONDS=60


# -----------------------------------------------------------------------------
# Realtime (Socket.io)
# -----------------------------------------------------------------------------
# Dashboard money events for the admin room. These signal WHEN to refetch —
# GET /reports/dashboard is always the source of truth.
# NOT public/secret-sensitive, but the browser needs it: expose via the root
# loader rather than a VITE_ prefix so it stays runtime-configurable.
# ⚠️ URL / namespace / auth handshake are NOT in the OpenAPI spec — confirm
#    with the backend team before wiring this up (TASK.md §7.4).
SOCKET_URL=https://staging-backend.yadahdynamic.com
SOCKET_PATH=/socket.io
SOCKET_ENABLED=false


# -----------------------------------------------------------------------------
# Locale / money / time
# -----------------------------------------------------------------------------
# Business days are Accra calendar days. Never let the browser timezone shift a
# day boundary — all `accraDay` (YYYY-MM-DD) values are rendered in this zone.
APP_TIMEZONE=Africa/Accra

# All API money values are INTEGER PESEWAS. GHS 10.50 => 1050. Never floats.
CURRENCY_CODE=GHS
CURRENCY_SYMBOL=GH₵
CURRENCY_MINOR_UNITS=100

DEFAULT_LOCALE=en-GH

# Default inclusive Accra-day window for statements, transaction feeds and
# collections reports.
DEFAULT_DATE_RANGE_DAYS=30


# -----------------------------------------------------------------------------
# Uploads  (mirror of the API's server-side limits — for client-side pre-checks)
# -----------------------------------------------------------------------------
# POST /uploads/images — multipart, field name `image`.
# The API rejects oversize/wrong-type with FILE_TOO_LARGE / UNSUPPORTED_FILE_TYPE.
# These values exist only to fail fast in the browser; the API is authoritative.
UPLOAD_MAX_BYTES=5242880
UPLOAD_ACCEPTED_TYPES=image/jpeg,image/png,image/webp

# Uploads are NOT attached to any record by the upload call. Abandoned or
# replaced images must be cleaned up via DELETE /uploads/images or they orphan.
UPLOAD_CLEANUP_ON_ABANDON=true


# -----------------------------------------------------------------------------
# Pagination & exports  (mirror of API behaviour)
# -----------------------------------------------------------------------------
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# format=csv|xlsx ignores pagination and is capped server-side at 10,000 rows.
# Surface this cap in the UI so a truncated export is never mistaken for a
# complete one.
EXPORT_MAX_ROWS=10000


# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------
# Hire Purchase Stage B — instalment schedules, the confirmed interest method,
# and automatic arrears flagging. NOT implemented server-side yet; blocked on a
# client decision (TASK.md §7.1). Keep false until confirmed.
FEATURE_HP_STAGE_B=false

# Paystack mobile-money charges. Turn off to hide the charge UI entirely when
# the backend returns PAYMENTS_NOT_CONFIGURED.
FEATURE_PAYSTACK_CHARGES=true

# Queued offline deposit capture for field collectors. Safe by design because
# money endpoints take an idempotencyKey, but the UX is unbuilt — scope TBD
# (TASK.md §7.3).
FEATURE_OFFLINE_CAPTURE=false

# Admin-only background worker heartbeat panel (GET /reports/workers).
# Counters are IN-MEMORY and reset on backend restart — label accordingly.
FEATURE_WORKER_HEARTBEATS=true


# -----------------------------------------------------------------------------
# Paystack (client-facing display only)
# -----------------------------------------------------------------------------
# The frontend NEVER holds a Paystack secret key. Charges are initiated by the
# backend via POST /payments/charges; the webhook is server-to-server and
# HMAC-signed. Do not add PAYSTACK_SECRET_KEY here.
#
# How long to poll GET /payments/charges/{reference} before telling the user to
# check back later. The customer approves a prompt on their handset (pay_offline).
PAYSTACK_POLL_INTERVAL_MS=4000
PAYSTACK_POLL_TIMEOUT_MS=180000


# -----------------------------------------------------------------------------
# Observability (optional — leave blank to disable)
# -----------------------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=debug
