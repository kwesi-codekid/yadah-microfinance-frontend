# Copy to .env and fill in. Read by app/lib/env.server.ts (server-only).

# Base URL for the Yadah Microfinance API, including the /api/v1 prefix.
API_BASE_URL=https://yadah-backend-staging.adamusgh.com/api/v1

# Secret used to sign the session cookie. REQUIRED in production; set to a long
# random value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
